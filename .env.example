# New stack: copy to .env.local (Windows local-db creates it automatically).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:55432/haedap
CHROMA_PATH=data/chroma
VECTOR_ENABLED=0
LLM_ENABLED=0
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=
LLM_API_KEY=
ALLOW_EXTERNAL_LLM=0

# Legacy only: copy these to .env for npm run legacy.
HAEDAP_DB_PATH=data/haedap.sqlite
PORT=5173
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional standalone role4 API (service.role4_standalone, port 8001).
# Generate a random token of at least 32 characters before running standalone API.
ROLE4_API_TOKEN=
