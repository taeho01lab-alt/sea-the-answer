{
  "name": "haedap-maritime-demo",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "Haedap compact UI with public access and administrator-managed local document, operations, reporting and backup workflows",
  "scripts": {
    "start": "node scripts/start-stack.mjs",
    "ui": "node server.mjs",
    "legacy": "node server.mjs",
    "start:lan": "node server.mjs --lan",
    "dev": "node scripts/start-stack.mjs",
    "build": "npm --prefix web run build",
    "test": "node --test tests/*.test.mjs",
    "ingest": "node scripts/ingest.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:ui": "node --experimental-vm-modules scripts/ui-smoke.mjs",
    "check": "node scripts/check-runtime.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "linkedom": "0.18.13"
  }
}
